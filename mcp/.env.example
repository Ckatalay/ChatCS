# Must match backend/.env exactly — this server verifies tokens the backend
# signs. If the two drift, every request 401s.
JWT_SECRET=

# Non-owner role, so Postgres RLS actually applies. Connecting as postgres
# would silently bypass tenant isolation. See backend/db/init/02-cve-rls.sql.
DB_DSN=host=localhost port=5433 dbname=postgres user=cve_mcp password=cve_mcp
